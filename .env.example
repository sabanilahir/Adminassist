# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ticket_db?schema=public"

# NextAuth.js
AUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# LDAP/Active Directory Configuration (Optional)
# Set LDAP_ENABLED=true to enable AD authentication
LDAP_ENABLED=false
LDAP_URL="ldap://your-ad-server.domain.com:389"
LDAP_BASE_DN="DC=domain,DC=local"
LDAP_USER_SEARCH_BASE="OU=Users,DC=domain,DC=local"
# Service account for searching users (optional - for read-only search)
LDAP_BIND_DN="CN=service-account,OU=Service Accounts,DC=domain,DC=local"
LDAP_BIND_PASSWORD="service-account-password"

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=helpdesk@company.com

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Microsoft Entra ID (Azure AD) Configuration
# Note: These values can also be configured via Admin UI at /admin/settings
# Azure Portal > Microsoft Entra ID > App registrations > New registration
AUTH_MICROSOFT_ENTRA_ID_ID="your-azure-client-id"
AUTH_MICROSOFT_ENTRA_ID_SECRET="your-azure-client-secret"
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID="your-tenant-id"
